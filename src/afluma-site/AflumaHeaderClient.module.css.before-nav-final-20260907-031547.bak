  width:
    100% !important;

  max-width:
    none !important;
}


/* =========================================================
   OPEN MENU DESKTOP
   ========================================================= */

/*
 * Hero:
 * 6px top gutter
 * ~100svh height
 *
 * Navbar sits inside hero.
 * Mega menu occupies everything under navbar while
 * retaining the hero's bottom radius.
 */

.megaMenu {
  top:
    72px !important;

  left:
    8px !important;

  right:
    8px !important;

  width:
    auto !important;

  max-width:
    none !important;

  height:
    calc(100svh - 80px)
    !important;

  min-height:
    0 !important;

  max-height:
    none !important;

  border-radius:
    22px 22px 27px 27px
    !important;
}


