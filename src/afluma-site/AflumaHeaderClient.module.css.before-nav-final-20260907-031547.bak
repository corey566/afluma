    right:
      4px !important;

    width:
      auto !important;

    height:
      calc(100svh - 62px)
      !important;

    min-height:
      0 !important;

    max-height:
      none !important;

    border-radius:
      17px 17px 19px 19px
      !important;
  }

}


/* =========================================================
   VERY SMALL MOBILE
   ========================================================= */

@media (
  max-width: 390px
) {

