.header {
  position: fixed;

  z-index: 1300;

  top: 18px;
  left: 0;
  right: 0;

  padding:
    0 clamp(18px, 2.2vw, 38px);

  pointer-events: none;
}

.navShell {
  width: min(100%, 1780px);

  margin: 0 auto;

  display: grid;

  grid-template-columns:
    auto
    minmax(0, 1fr)
    auto;

  align-items: center;

  gap:
    clamp(16px, 2vw, 30px);

  pointer-events: auto;
}

/* =========================================================
   LEFT
   ========================================================= */

.leftCluster,
.rightCluster {
  display: flex;

  align-items: center;

  gap: 8px;
}

.brandPill,
.soundPill,
.navPill,
.projectPill,
.menuPill {
  border:
    1px solid
    rgba(255, 255, 255, .42);

  box-shadow:
    inset 0 1px 0
    rgba(255, 255, 255, .14),
    0 8px 28px
    rgba(28, 28, 65, .08);

  backdrop-filter:
    blur(18px)
    saturate(125%);

  -webkit-backdrop-filter:
    blur(18px)
    saturate(125%);
}

.brandPill {
  height: 48px;

  padding:
    0 16px;

  display: flex;

  align-items: center;

  border-radius: 999px;

  background:
    rgba(255, 255, 255, .10);

  text-decoration: none;
}

.brandPill img {
  width: 112px;
  height: auto;

  display: block;
}

.soundPill {
  height: 48px;

  min-width: 77px;

  padding:
    0 13px;

  display: inline-flex;

  align-items: center;

  justify-content: center;

  gap: 8px;

  appearance: none;

  border-radius: 999px;

  background:
    rgba(42, 37, 73, .18);

  color: #ffffff;

  cursor: pointer;

  transition:
    transform 260ms
    cubic-bezier(.22, 1, .36, 1),
    background-color 260ms ease;
}

.soundPill:hover {
  transform:
    translateY(-1px);

  background:
    rgba(42, 37, 73, .27);
}

.soundPillPlaying {
  background:
    rgba(91, 62, 121, .34);
}

.soundText {
  font-size: 8px;

  font-weight: 600;

  letter-spacing: .11em;
}

.waveform {
  width: 20px;
  height: 18px;

  display: flex;

  align-items: center;
  justify-content: center;

  gap: 2px;
}

.waveform i {
  width: 2px;
  height: 4px;

  display: block;

  border-radius: 99px;

  background: currentColor;
}

.waveform i:nth-child(2) {
  height: 8px;
}

.waveform i:nth-child(3) {
  height: 13px;
}

.waveform i:nth-child(4) {
  height: 8px;
}

.waveformPlaying i {
  animation:
    aflumaWave 650ms
    ease-in-out
    infinite alternate;
}

.waveformPlaying i:nth-child(2) {
  animation-delay: -140ms;
}

.waveformPlaying i:nth-child(3) {
  animation-delay: -380ms;
}

.waveformPlaying i:nth-child(4) {
  animation-delay: -90ms;
}

.waveformPlaying i:nth-child(5) {
  animation-delay: -260ms;
}

/* =========================================================
   CENTER NAV
   ========================================================= */

.primaryNav {
  justify-self: center;

  display: flex;

  align-items: center;

  gap: 5px;
}

.navPill {
  min-height: 42px;

  padding:
    0 17px;

  display: inline-flex;

  align-items: center;

  border-radius: 999px;

  background:
    rgba(48, 44, 81, .10);

  color:
    rgba(255, 255, 255, .91);

  font-size: 10px;

  font-weight: 500;

  text-decoration: none;

  text-shadow:
    0 1px 9px
    rgba(30, 28, 58, .10);

  transition:
    transform 250ms
    cubic-bezier(.22, 1, .36, 1),
    background-color 250ms ease,
    color 250ms ease;
}

.navPill:hover {
  transform:
    translateY(-1px);

  background:
    rgba(255, 255, 255, .18);

  color: #ffffff;
}

.navPillActive {
  background:
    rgba(255, 253, 249, .94);

  color: #30283c;

  border-color:
    rgba(255, 255, 255, .74);

  text-shadow: none;

  box-shadow:
    0 8px 26px
    rgba(38, 31, 67, .10);
}

/* =========================================================
   RIGHT
   ========================================================= */

.rightCluster {
  justify-self: end;
}

.projectPill {
  height: 48px;

  padding:
    0 18px;

  display: inline-flex;

  align-items: center;

  gap: 8px;

  border-radius: 999px;

  background:
    rgba(255, 253, 249, .94);

  color: #33273d;

  font-size: 10px;

  font-weight: 600;

  text-decoration: none;

  transition:
    transform 260ms
    cubic-bezier(.22, 1, .36, 1);
}

.projectPill:hover {
  transform:
    translateY(-1px);
}

.projectArrow {
  width: 15px;
  height: 15px;

  display: inline-flex;
}

.projectArrow svg {
  width: 100%;
  height: 100%;
}

.menuPill {
  height: 48px;

  min-width: 86px;

  padding:
    0 13px 0 16px;

  display: inline-flex;

  align-items: center;

  justify-content: space-between;

  gap: 13px;

  appearance: none;

  border-radius: 999px;

  background:
    rgba(39, 35, 66, .24);

  color: #ffffff;

  cursor: pointer;

  transition:
    transform 260ms
    cubic-bezier(.22, 1, .36, 1),
    background-color 260ms ease;
}

.menuPill:hover,
.menuPillOpen {
  background:
    rgba(39, 35, 66, .36);
}

.menuPill:hover {
  transform:
    translateY(-1px);
}

.menuWord {
  font-size: 9px;

  font-weight: 600;
}

.menuIcon {
  position: relative;

  width: 17px;
  height: 17px;

  display: block;
}

.menuIcon i {
  position: absolute;

  left: 2px;

  width: 13px;
  height: 1.5px;

  border-radius: 999px;

  background: currentColor;

  transition:
    top 300ms
    cubic-bezier(.22, 1, .36, 1),
    transform 300ms
    cubic-bezier(.22, 1, .36, 1);
}

.menuIcon i:first-child {
  top: 5px;
}

.menuIcon i:last-child {
  top: 11px;
}

.menuIconOpen i:first-child {
  top: 8px;

  transform:
    rotate(45deg);
}

.menuIconOpen i:last-child {
  top: 8px;

  transform:
    rotate(-45deg);
}

/* =========================================================
   NON HOME SPACER
   ========================================================= */

.nonHomeSpacer {
  height: 82px;
}

/* =========================================================
   BACKDROP
   ========================================================= */

.menuBackdrop {
  position: fixed;

  z-index: 1180;

  inset: 0;

  width: 100%;
  height: 100%;

  appearance: none;

  border: 0;

  background:
    rgba(27, 24, 46, .26);

  backdrop-filter:
    blur(9px);

  -webkit-backdrop-filter:
    blur(9px);

  opacity: 0;

  visibility: hidden;

  pointer-events: none;

  transition:
    opacity 380ms ease,
    visibility 380ms ease;
}

.menuBackdropVisible {
  opacity: 1;

  visibility: visible;

  pointer-events: auto;
}

/* =========================================================
   MEGA MENU
   ========================================================= */

.megaMenu {
  position: fixed;

  z-index: 1200;

  top: 82px;
  left: 50%;

  width:
    min(
      calc(100vw - 34px),
      1760px
    );

  height:
    min(
      calc(100dvh - 100px),
      720px
    );

  min-height: 560px;

  overflow: hidden;

  border:
    1px solid
    rgba(255, 255, 255, .76);

  border-radius: 28px;

  background:
    linear-gradient(
      115deg,
      #fbf8f3 0%,
      #faf7f4 48%,
      #f0eaf4 100%
    );

  box-shadow:
    0 35px 100px
    rgba(34, 27, 53, .20);

  opacity: 0;

  visibility: hidden;

  pointer-events: none;

  transform:
    translateX(-50%)
    translateY(-12px)
    scale(.988);

  transform-origin:
    top center;

  transition:
    opacity 380ms ease,
    visibility 380ms ease,
    transform 520ms
    cubic-bezier(.22, 1, .36, 1);
}

.megaMenuOpen {
  opacity: 1;

  visibility: visible;

  pointer-events: auto;

  transform:
    translateX(-50%)
    translateY(0)
    scale(1);
}

.menuAtmosphere {
  position: absolute;

  top: -320px;
  right: -250px;

  width: 800px;
  height: 800px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(204, 181, 228, .27),
      rgba(215, 207, 239, .12) 43%,
      transparent 70%
    );

  pointer-events: none;
}

/* =========================================================
   MENU GRID
   ========================================================= */

.menuGrid {
  position: relative;

  z-index: 2;

  height:
    calc(100% - 58px);

  padding:
    clamp(38px, 4.5vw, 72px)
    clamp(42px, 6vw, 94px);

  display: grid;

  grid-template-columns:
    minmax(260px, .82fr)
    minmax(330px, .92fr)
    minmax(300px, .82fr);

  align-items: start;

  gap:
    clamp(42px, 5.5vw, 92px);
}

/* =========================================================
   INTRO
   ========================================================= */

.menuIntro {
  padding-top: 19px;
}

.menuKicker {
  display: flex;

  align-items: center;

  gap: 9px;

  color:
    rgba(63, 48, 75, .50);

  font-size: 8px;

  font-weight: 600;

  letter-spacing: .14em;

  text-transform: uppercase;
}

.menuKicker i {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #8a49ef;
}

.menuIntro h2 {
  margin:
    29px 0 0;

  color: #21182b;

  font-family:
    Poppins,
    Inter,
    Arial,
    sans-serif;

  font-size:
    clamp(39px, 3.4vw, 57px);

  font-weight: 400;

  line-height: .98;

  letter-spacing: -.057em;
}

.menuIntro p {
  max-width: 300px;

  margin:
    21px 0 0;

  color:
    rgba(46, 35, 57, .54);

  font-size: 11px;

  line-height: 1.7;
}

.menuContact {
  margin-top: 25px;

  width: fit-content;

  display: inline-flex;

  align-items: center;

  gap: 8px;

  color: #7b3eaa;

  font-size: 10px;

  font-weight: 600;

  text-decoration: none;
}

.menuContact svg {
  width: 14px;
  height: 14px;
}

/* =========================================================
   NAV COLUMN
   ========================================================= */

.menuNavigation {
  min-width: 0;

  padding-left:
    clamp(15px, 2vw, 35px);

  border-left:
    1px solid
    rgba(58, 43, 70, .09);
}

.columnLabel {
  display: block;

  padding-bottom: 19px;

  color:
    rgba(56, 42, 68, .45);

  font-size: 8px;

  font-weight: 600;

  letter-spacing: .15em;

  text-transform: uppercase;
}

.menuLinks {
  display: grid;

  border-top:
    1px solid
    rgba(55, 41, 66, .09);
}

.menuLinks a {
  min-height: 56px;

  display: grid;

  grid-template-columns:
    31px
    minmax(0, 1fr)
    20px;

  align-items: center;

  border-bottom:
    1px solid
    rgba(55, 41, 66, .09);

  color: #261b2f;

  text-decoration: none;

  transition:
    padding-left 280ms
    cubic-bezier(.22, 1, .36, 1),
    background-color 280ms ease;
}

.menuLinks a:hover {
  padding-left: 7px;

  background:
    linear-gradient(
      90deg,
      rgba(190, 158, 219, .12),
      transparent
    );
}

.linkNumber {
  color:
    rgba(52, 38, 64, .30);

  font-size: 7px;

  font-weight: 600;
}

.linkName {
  font-family:
    Poppins,
    Inter,
    Arial,
    sans-serif;

  font-size:
    clamp(19px, 1.6vw, 25px);

  font-weight: 400;

  letter-spacing: -.04em;
}

.linkArrow {
  width: 14px;
  height: 14px;

  color: #7a36dc;

  opacity: .55;
}

.linkArrow svg {
  width: 100%;
  height: 100%;
}

/* =========================================================
   EXPLORE COLUMN
   ========================================================= */

.menuExplore {
  min-width: 0;

  padding-left:
    clamp(15px, 2vw, 35px);

  border-left:
    1px solid
    rgba(58, 43, 70, .09);
}

.menuExplore h3 {
  margin:
    2px 0 0;

  color: #261b30;

  font-family:
    Poppins,
    Inter,
    Arial,
    sans-serif;

  font-size:
    clamp(26px, 2.25vw, 37px);

  font-weight: 400;

  line-height: 1.02;

  letter-spacing: -.05em;
}

.menuExplore > p {
  max-width: 300px;

  margin:
    15px 0 0;

  color:
    rgba(51, 38, 62, .52);

  font-size: 10px;

  line-height: 1.7;
}

.exploreLinks {
  margin-top: 28px;

  display: grid;

  border-top:
    1px solid
    rgba(57, 42, 69, .09);
}

.exploreLinks a {
  min-height: 51px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  gap: 15px;

  border-bottom:
    1px solid
    rgba(57, 42, 69, .09);

  color: #372742;

  font-size: 10px;

  text-decoration: none;
}

.exploreLinks a span:last-child {
  width: 13px;
  height: 13px;

  color: #7133d8;
}

.exploreLinks svg {
  width: 100%;
  height: 100%;
}

/* =========================================================
   MENU FOOTER
   ========================================================= */

.menuFooter {
  position: absolute;

  z-index: 4;

  left: 52px;
  right: 52px;
  bottom: 0;

  height: 58px;

  display: grid;

  grid-template-columns:
    1fr
    auto
    1fr;

  align-items: center;

  border-top:
    1px solid
    rgba(56, 42, 68, .09);

  color:
    rgba(52, 39, 63, .42);

  font-size: 8px;
}

.menuFooter > div {
  display: flex;

  align-items: center;

  gap: 24px;
}

.menuFooter a {
  color: inherit;

  text-decoration: none;
}

.menuFooter > span:last-child {
  justify-self: end;
}

/* =========================================================
   TABLET
   ========================================================= */

@media (max-width: 1120px) {
  .primaryNav {
    gap: 3px;
  }

  .navPill {
    padding:
      0 12px;

    font-size: 9px;
  }

  .projectPill {
    display: none;
  }

  .menuGrid {
    grid-template-columns:
      minmax(240px, .75fr)
      minmax(300px, 1fr)
      minmax(260px, .8fr);

    gap: 35px;

    padding-inline: 40px;
  }
}

/* =========================================================
   MOBILE
   ========================================================= */

@media (max-width: 760px) {
  .header {
    top: 13px;

    padding-inline: 13px;
  }

  .navShell {
    display: flex;

    align-items: center;

    justify-content: space-between;

    gap: 7px;
  }

  .leftCluster {
    gap: 6px;
  }

  .brandPill {
    height: 44px;

    padding:
      0 12px;
  }

  .brandPill img {
    width: 92px;
  }

  .soundPill {
    width: 44px;
    min-width: 44px;
    height: 44px;

    padding: 0;
  }

  .soundText {
    display: none;
  }

  .primaryNav {
    display: none;
  }

  .projectPill {
    display: none;
  }

  .menuPill {
    min-width: 44px;
    width: 44px;
    height: 44px;

    padding: 0;

    justify-content: center;
  }

  .menuWord {
    display: none;
  }

  .megaMenu {
    top: 69px;

    width:
      calc(100vw - 18px);

    height:
      calc(100dvh - 78px);

    min-height: 0;

    border-radius: 22px;
  }

  .menuGrid {
    height:
      calc(100% - 53px);

    padding:
      29px 20px 35px;

    display: block;

    overflow-y: auto;

    scrollbar-width: none;
  }

  .menuGrid::-webkit-scrollbar {
    display: none;
  }

  .menuIntro {
    padding-top: 0;
  }

  .menuIntro h2 {
    margin-top: 20px;

    font-size:
      clamp(40px, 11vw, 52px);
  }

  .menuIntro p {
    max-width: 340px;
  }

  .menuNavigation,
  .menuExplore {
    margin-top: 35px;

    padding-left: 0;

    border-left: 0;
  }

  .menuLinks a {
    min-height: 55px;
  }

  .linkName {
    font-size:
      clamp(23px, 7vw, 31px);
  }

  .menuExplore h3 {
    font-size: 32px;
  }

  .menuFooter {
    left: 20px;
    right: 20px;

    height: 53px;

    grid-template-columns:
      1fr
      auto;
  }

  .menuFooter > div {
    display: none;
  }

  .menuFooter > span:last-child {
    justify-self: end;
  }
}

/* =========================================================
   MOTION
   ========================================================= */

@keyframes aflumaWave {
  from {
    height: 3px;
  }

  to {
    height: 15px;
  }
}

@media (
  prefers-reduced-motion:
  reduce
) {
  .megaMenu,
  .menuBackdrop,
  .navPill,
  .soundPill,
  .projectPill,
  .menuPill,
  .waveform i {
    transition-duration:
      .01ms !important;

    animation-duration:
      .01ms !important;
  }

  .waveformPlaying i {
    animation: none;
  }
}
/* AFLUMA NAV V6 NEVAN
   ========================================================= */

/* =========================================================
   AFLUMA WORDMARK FONT
   ========================================================= */

@font-face {
  font-family: 'Afluma Nevan';

  src:
    url('/fonts/afluma-nevan.woff2')
    format('woff2');

  font-style: normal;
  font-weight: 400;
  font-display: swap;
}

.brandPill {
  min-width:
    126px !important;

  justify-content:
    center !important;

  overflow:
    visible !important;
}

.brandPill img {
  display:
    none !important;
}

.brandWordmark {
  display:
    inline-block;

  color:
    #251931;

  font-family:
    'Afluma Nevan',
    sans-serif;

  font-size:
    25px;

  font-style:
    normal;

  font-weight:
    400;

  line-height:
    1;

  letter-spacing:
    .12em;

  white-space:
    nowrap;

  transform:
    translateX(.06em);
}

.srOnly {
  position:
    absolute;

  width:
    1px;

  height:
    1px;

  padding:
    0;

  margin:
    -1px;

  overflow:
    hidden;

  clip:
    rect(0,0,0,0);

  white-space:
    nowrap;

  border:
    0;
}

/* =========================================================
   HERO NAV
   ========================================================= */

.header[data-surface='hero']
.brandPill {
  background:
    rgba(255,255,255,.09);

  border-color:
    rgba(255,255,255,.38);
}

.header[data-surface='hero']
.brandWordmark {
  color:
    #21182d;
}

.header[data-surface='hero']
.soundPill {
  background:
    rgba(42,37,72,.20);

  color:
    #fff;

  border-color:
    rgba(255,255,255,.38);
}

.header[data-surface='hero']
.navPill {
  background:
    rgba(45,41,75,.09);

  color:
    rgba(255,255,255,.93);

  border-color:
    rgba(255,255,255,.38);
}

.header[data-surface='hero']
.menuPill {
  background:
    rgba(39,34,66,.25);

  color:
    #fff;

  border-color:
    rgba(255,255,255,.36);
}

/* =========================================================
   NAV BELOW HERO
   ========================================================= */

.header[data-surface='page'] {
  top:
    12px;
}

.header[data-surface='page']
.brandPill,
.header[data-surface='page']
.soundPill,
.header[data-surface='page']
.navPill,
.header[data-surface='page']
.menuPill {
  background:
    rgba(255,253,249,.94);

  border-color:
    rgba(64,44,76,.11);

  color:
    #33243f;

  text-shadow:
    none;

  box-shadow:
    0 9px 30px
    rgba(47,35,58,.09),
    inset 0 1px 0
    rgba(255,255,255,.97);

  backdrop-filter:
    blur(22px)
    saturate(120%);

  -webkit-backdrop-filter:
    blur(22px)
    saturate(120%);
}

.header[data-surface='page']
.brandWordmark {
  color:
    #2e2038;
}

.header[data-surface='page']
.navPill:hover,
.header[data-surface='page']
.soundPill:hover,
.header[data-surface='page']
.menuPill:hover {
  background:
    #eee5f2;

  color:
    #281c31;
}

.header[data-surface='page']
.navPillActive {
  background:
    #dacee6;

  color:
    #382247;
}

.header[data-surface='page']
.projectPill {
  background:
    #3c2948;

  color:
    #fff;

  border-color:
    rgba(54,36,66,.14);

  box-shadow:
    0 11px 31px
    rgba(49,31,60,.17);
}

.header[data-surface='page']
.soundPillPlaying {
  background:
    #ded0e9;

  color:
    #40264f;
}

/* =========================================================
   MENU OPEN
   ========================================================= */

.header[data-menu-open='true']
.brandPill,
.header[data-menu-open='true']
.soundPill,
.header[data-menu-open='true']
.navPill,
.header[data-menu-open='true']
.menuPill {
  background:
    rgba(255,253,249,.96);

  border-color:
    rgba(64,44,76,.11);

  color:
    #33243f;

  text-shadow:
    none;
}

.header[data-menu-open='true']
.brandWordmark {
  color:
    #2b1e35;
}

.header[data-menu-open='true']
.projectPill {
  background:
    #3c2948;

  color:
    #fff;
}

.brandPill,
.soundPill,
.navPill,
.projectPill,
.menuPill {
  transition:
    color 350ms ease,
    background-color 350ms ease,
    border-color 350ms ease,
    box-shadow 350ms ease,
    transform 260ms
    cubic-bezier(.22,1,.36,1);
}

/* MOBILE */

@media (
  max-width: 760px
) {

  .brandPill {
    min-width:
      105px !important;
  }

  .brandWordmark {
    font-size:
      21px;

    letter-spacing:
      .10em;
  }

}


/* AFLUMA NAV V7 FINAL CONTRAST
   ========================================================= */

/* =========================================================
   EXACT NEVAN RUS WORDMARK
   ========================================================= */

.brandPill {
  min-width:
    146px !important;

  height:
    48px !important;

  padding:
    0 18px !important;

  justify-content:
    center !important;

  overflow:
    visible !important;
}

.brandPill img {
  display:
    none !important;
}

.brandWordmark {
  display:
    block !important;

  margin:
    0 !important;

  padding:
    0 !important;

  color:
    #26192f;

  font-family:
    'AflumaNevan',
    sans-serif !important;

  font-size:
    25px !important;

  font-style:
    normal !important;

  font-weight:
    400 !important;

  font-synthesis:
    none !important;

  line-height:
    1 !important;

  letter-spacing:
    .075em !important;

  text-transform:
    uppercase !important;

  white-space:
    nowrap !important;

  transform:
    translateY(1px) !important;
}

/* Hide any old duplicated helper text. */

.srOnly {
  position:
    absolute !important;

  width:
    1px !important;

  height:
    1px !important;

  padding:
    0 !important;

  margin:
    -1px !important;

  overflow:
    hidden !important;

  clip:
    rect(0,0,0,0) !important;

  clip-path:
    inset(50%) !important;

  white-space:
    nowrap !important;

  border:
    0 !important;
}

/* =========================================================
   HERO MODE
   ========================================================= */

.header[data-surface='hero']
.brandPill {
  background:
    rgba(255,255,255,.10) !important;

  border-color:
    rgba(255,255,255,.40) !important;
}

.header[data-surface='hero']
.brandWordmark {
  color:
    #25182f !important;
}

.header[data-surface='hero']
.soundPill {
  background:
    rgba(47,38,76,.24) !important;

  border-color:
    rgba(255,255,255,.36) !important;

  color:
    #fff !important;
}

.header[data-surface='hero']
.navPill {
  background:
    rgba(55,48,87,.12) !important;

  border-color:
    rgba(255,255,255,.38) !important;

  color:
    rgba(255,255,255,.94) !important;

  text-shadow:
    0 1px 8px
    rgba(27,22,49,.11) !important;
}

.header[data-surface='hero']
.navPillActive {
  background:
    rgba(255,253,249,.94) !important;

  color:
    #34263e !important;

  text-shadow:
    none !important;
}

.header[data-surface='hero']
.menuPill {
  background:
    rgba(42,34,69,.27) !important;

  border-color:
    rgba(255,255,255,.36) !important;

  color:
    #fff !important;
}

/* =========================================================
   OUTSIDE HERO
   ========================================================= */

/*
 * Dark Bento controls work over:
 *
 * - white content
 * - ivory content
 * - lavender content
 * - dark sections
 *
 * So the navigation never disappears again.
 */

.header[data-surface='page'] {
  top:
    12px !important;
}

.header[data-surface='page']
.brandPill,
.header[data-surface='page']
.soundPill,
.header[data-surface='page']
.navPill,
.header[data-surface='page']
.menuPill {
  background:
    rgba(35,27,47,.90) !important;

  border-color:
    rgba(255,255,255,.15) !important;

  color:
    rgba(255,255,255,.94) !important;

  text-shadow:
    none !important;

  box-shadow:
    0 10px 32px
    rgba(22,16,32,.17),
    inset 0 1px 0
    rgba(255,255,255,.09) !important;

  backdrop-filter:
    blur(22px)
    saturate(125%) !important;

  -webkit-backdrop-filter:
    blur(22px)
    saturate(125%) !important;
}

.header[data-surface='page']
.brandWordmark {
  color:
    #ffffff !important;
}

.header[data-surface='page']
.navPill:hover,
.header[data-surface='page']
.soundPill:hover,
.header[data-surface='page']
.menuPill:hover {
  background:
    rgba(70,48,86,.94) !important;

  color:
    #ffffff !important;
}

.header[data-surface='page']
.navPillActive {
  background:
    #8d68a8 !important;

  border-color:
    rgba(255,255,255,.19) !important;

  color:
    #ffffff !important;

  box-shadow:
    0 8px 28px
    rgba(43,27,57,.20) !important;
}

.header[data-surface='page']
.soundPillPlaying {
  background:
    #684779 !important;

  color:
    #ffffff !important;
}

/*
 * CTA deliberately remains light so it is visually
 * distinguishable from the navigation controls.
 */

.header[data-surface='page']
.projectPill {
  background:
    rgba(255,253,249,.97) !important;

  border-color:
    rgba(255,255,255,.74) !important;

  color:
    #30213b !important;

  box-shadow:
    0 11px 32px
    rgba(25,17,35,.16) !important;
}

/* =========================================================
   MENU OPEN
   ========================================================= */

.header[data-menu-open='true']
.brandPill,
.header[data-menu-open='true']
.soundPill,
.header[data-menu-open='true']
.navPill,
.header[data-menu-open='true']
.menuPill {
  background:
    rgba(35,27,47,.94) !important;

  border-color:
    rgba(255,255,255,.15) !important;

  color:
    #ffffff !important;
}

.header[data-menu-open='true']
.brandWordmark {
  color:
    #ffffff !important;
}

.header[data-menu-open='true']
.projectPill {
  background:
    #fffdf9 !important;

  color:
    #30213b !important;
}

/* =========================================================
   SMOOTH TRANSITION
   ========================================================= */

.brandPill,
.soundPill,
.navPill,
.projectPill,
.menuPill,
.brandWordmark {
  transition:
    color 360ms ease,
    background-color 360ms ease,
    border-color 360ms ease,
    box-shadow 360ms ease,
    transform 260ms
    cubic-bezier(.22,1,.36,1)
    !important;
}

/* =========================================================
   MEDIUM DESKTOP / SMALL LAPTOP
   ========================================================= */

@media (
  min-width: 981px
) and (
  max-width: 1180px
) {

  .header {
    padding-inline:
      16px !important;
  }

  .navShell {
    gap:
      12px !important;
  }

  .brandPill {
    min-width:
      132px !important;

    padding-inline:
      14px !important;
  }

  .brandWordmark {
    font-size:
      22px !important;
  }

  .primaryNav {
    gap:
      3px !important;
  }

  .navPill {
    min-height:
      40px !important;

    padding-inline:
      10px !important;

    font-size:
      9px !important;
  }

  .projectPill {
    display:
      none !important;
  }

}

/* =========================================================
   TABLET
   ========================================================= */

@media (
  min-width: 761px
) and (
  max-width: 980px
) {

  .header {
    top:
      12px !important;

    padding-inline:
      14px !important;
  }

  .navShell {
    width:
      100% !important;

    display:
      flex !important;

    align-items:
      center !important;

    justify-content:
      space-between !important;

    gap:
      10px !important;
  }

  .leftCluster {
    gap:
      7px !important;
  }

  .brandPill {
    min-width:
      136px !important;

    height:
      46px !important;

    padding-inline:
      15px !important;

    border-radius:
      999px !important;
  }

  .brandWordmark {
    font-size:
      23px !important;

    letter-spacing:
      .07em !important;
  }

  .soundPill {
    height:
      46px !important;

    min-width:
      70px !important;
  }

  /*
   * Tablet becomes intentionally minimal.
   * Main links live in Menu instead of being squeezed.
   */

  .primaryNav {
    display:
      none !important;
  }

  .projectPill {
    display:
      none !important;
  }

  .rightCluster {
    margin-left:
      auto !important;
  }

  .menuPill {
    height:
      46px !important;

    min-width:
      82px !important;
  }

}

/* =========================================================
   MOBILE
   ========================================================= */

@media (
  max-width: 760px
) {

  .header {
    top:
      10px !important;

    padding-inline:
      10px !important;
  }

  .navShell {
    width:
      100% !important;

    display:
      flex !important;

    align-items:
      center !important;

    justify-content:
      space-between !important;

    gap:
      6px !important;
  }

  .leftCluster {
    min-width:
      0 !important;

    gap:
      5px !important;
  }

  .brandPill {
    min-width:
      112px !important;

    height:
      42px !important;

    padding:
      0 11px !important;
  }

  .brandWordmark {
    font-size:
      19px !important;

    letter-spacing:
      .065em !important;

    transform:
      translateY(1px) !important;
  }

  .soundPill {
    width:
      42px !important;

    min-width:
      42px !important;

    height:
      42px !important;

    padding:
      0 !important;
  }

  .soundText {
    display:
      none !important;
  }

  .primaryNav,
  .projectPill {
    display:
      none !important;
  }

  .rightCluster {
    margin-left:
      auto !important;
  }

  .menuPill {
    width:
      42px !important;

    min-width:
      42px !important;

    height:
      42px !important;

    padding:
      0 !important;

    justify-content:
      center !important;
  }

  .menuWord {
    display:
      none !important;
  }

}

/* =========================================================
   VERY SMALL PHONE
   ========================================================= */

@media (
  max-width: 380px
) {

  .header {
    padding-inline:
      7px !important;
  }

  .brandPill {
    min-width:
      102px !important;

    padding-inline:
      9px !important;
  }

  .brandWordmark {
    font-size:
      17px !important;
  }

}


/* AFLUMA NAV V8 HERO INTEGRATION
   ========================================================= */

/* =========================================================
   NAV POSITION
   ========================================================= */

.header {
  top:
    14px !important;

  padding-inline:
    clamp(38px, 3.45vw, 66px)
    !important;
}

.navShell {
  width:
    100% !important;

  max-width:
    1800px !important;

  margin-inline:
    auto !important;
}


/* =========================================================
   HERO NAV COLORS
   ========================================================= */

/*
 * The artwork itself is already light lavender.
 *
 * Using white type inside ultra-transparent pills gave
 * insufficient contrast.
 *
 * The primary nav therefore uses subtle ivory glass
 * + dark plum text while over the hero.
 */

.header[data-surface='hero']
.brandPill,
.header[data-surface='hero']
.navPill {
  background:
    rgba(255, 253, 249, .16)
    !important;

  border-color:
    rgba(255, 255, 255, .46)
    !important;

  color:
    #30223c
    !important;

  text-shadow:
    none !important;

  box-shadow:
    inset 0 1px 0
    rgba(255,255,255,.18),
    0 8px 24px
    rgba(39,31,65,.045)
    !important;

  backdrop-filter:
    blur(18px)
    saturate(115%)
    !important;

  -webkit-backdrop-filter:
    blur(18px)
    saturate(115%)
    !important;
}

.header[data-surface='hero']
.brandWordmark {
  color:
    #281a34 !important;
}

.header[data-surface='hero']
.navPill:hover {
  background:
    rgba(255,253,249,.31)
    !important;

  color:
    #21162c
    !important;
}

.header[data-surface='hero']
.navPillActive {
  background:
    rgba(255,253,249,.88)
    !important;

  color:
    #281c33
    !important;

  border-color:
    rgba(255,255,255,.68)
    !important;

  box-shadow:
    0 8px 25px
    rgba(36,28,59,.08)
    !important;
}


/* =========================================================
   SOUND
   ========================================================= */

.header[data-surface='hero']
.soundPill {
  background:
    rgba(70,45,87,.72)
    !important;

  border-color:
    rgba(255,255,255,.24)
    !important;

  color:
    #ffffff
    !important;

  box-shadow:
    0 8px 25px
    rgba(48,32,62,.11),
    inset 0 1px 0
    rgba(255,255,255,.12)
    !important;
}

.header[data-surface='hero']
.soundPillPlaying {
  background:
    rgba(91,55,111,.84)
    !important;
}


/* =========================================================
   MENU BUTTON
   ========================================================= */

.header[data-surface='hero']
.menuPill {
  background:
    rgba(57,43,77,.56)
    !important;

  border-color:
    rgba(255,255,255,.28)
    !important;

  color:
    #ffffff
    !important;
}

.header[data-surface='hero']
.menuPill:hover {
  background:
    rgba(57,43,77,.72)
    !important;
}


/* =========================================================
   PROJECT BUTTON
   ========================================================= */

.header[data-surface='hero']
.projectPill {
  background:
    rgba(255,253,249,.94)
    !important;

  color:
    #30223b
    !important;

  border-color:
    rgba(255,255,255,.72)
    !important;

  box-shadow:
    0 9px 28px
    rgba(40,31,57,.085)
    !important;
}


/* =========================================================
   PAGE / SCROLLED NAV COLORS
   ========================================================= */

/*
 * Do NOT use the previous black/navy capsules.
 *
 * This softer plum-tinted glass remains visible over
 * white/ivory content while still looking like the same
 * design language as the hero.
 */

.header[data-surface='page']
.brandPill,
.header[data-surface='page']
.navPill {
  background:
    rgba(244, 238, 247, .94)
    !important;

  border-color:
    rgba(80, 58, 94, .12)
    !important;

  color:
    #30213b
    !important;

  text-shadow:
    none !important;

  box-shadow:
    0 9px 28px
    rgba(43,33,55,.075),
    inset 0 1px 0
    rgba(255,255,255,.95)
    !important;

  backdrop-filter:
    blur(22px)
    saturate(120%)
    !important;

  -webkit-backdrop-filter:
    blur(22px)
    saturate(120%)
    !important;
}

.header[data-surface='page']
.brandWordmark {
  color:
    #2c1d37
    !important;
}

.header[data-surface='page']
.navPill:hover {
  background:
    #e8ddef
    !important;

  color:
    #24172e
    !important;
}

.header[data-surface='page']
.navPillActive {
  background:
    #634675
    !important;

  border-color:
    rgba(75,50,91,.18)
    !important;

  color:
    #ffffff
    !important;

  box-shadow:
    0 9px 27px
    rgba(64,42,78,.18)
    !important;
}


/* sound stays visually identifiable */

.header[data-surface='page']
.soundPill {
  background:
    #674576
    !important;

  border-color:
    rgba(77,48,92,.16)
    !important;

  color:
    #ffffff
    !important;

  box-shadow:
    0 9px 28px
    rgba(64,42,77,.15)
    !important;
}

.header[data-surface='page']
.soundPillPlaying {
  background:
    #78518a
    !important;
}


/* Menu becomes plum rather than near-black. */

.header[data-surface='page']
.menuPill {
  background:
    #51405e
    !important;

  border-color:
    rgba(68,46,80,.14)
    !important;

  color:
    #ffffff
    !important;

  box-shadow:
    0 9px 28px
    rgba(49,35,58,.14)
    !important;
}


/* Start Project stays a light anchor. */

.header[data-surface='page']
.projectPill {
  background:
    #fffdf9
    !important;

  border-color:
    rgba(65,46,76,.09)
    !important;

  color:
    #30213a
    !important;

  box-shadow:
    0 9px 28px
    rgba(45,33,54,.09)
    !important;
}


/* =========================================================
   MENU OPEN NAV STATE
   ========================================================= */

.header[data-menu-open='true']
.brandPill,
.header[data-menu-open='true']
.navPill {
  background:
    rgba(255,253,249,.96)
    !important;

  color:
    #2c1d37
    !important;

  border-color:
    rgba(68,47,79,.11)
    !important;
}

.header[data-menu-open='true']
brandWordmark {
  color:
    #2c1d37
    !important;
}

.header[data-menu-open='true']
.soundPill,
.header[data-menu-open='true']
.menuPill {
  background:
    #5d426c
    !important;

  color:
    #ffffff
    !important;
}


/* =========================================================
   OPEN MENU â€” FILL THE HERO
   ========================================================= */

/*
 * Hero top starts at 8px.
 *
 * Menu begins directly below navbar at ~75px and ends
 * at the same rounded hero bottom.
 *
 * 75 + (87svh - 67px) = 87svh + 8px
 */

.megaMenu {
  top:
    75px !important;

  left:
    clamp(34px,3.4vw,64px)
    !important;

  right:
    clamp(34px,3.4vw,64px)
    !important;

  width:
    auto !important;

  max-width:
    1800px !important;

  height:
    calc(87svh - 67px)
    !important;

  min-height:
    560px !important;

  max-height:
    780px !important;

  margin-inline:
    auto !important;

  border:
    1px solid
    rgba(255,255,255,.80)
    !important;

  border-radius:
    24px 24px 29px 29px
    !important;

  background:
    linear-gradient(
      110deg,
      #faf7f2 0%,
      #faf7f3 48%,
      #eee7f2 100%
    )
    !important;

  box-shadow:
    0 28px 80px
    rgba(41,29,54,.15)
    !important;

  transform:
    translateY(-10px)
    scale(.992)
    !important;

  transform-origin:
    top center !important;
}

.megaMenuOpen {
  transform:
    translateY(0)
    scale(1)
    !important;
}


/* =========================================================
   MENU ATMOSPHERE
   ========================================================= */

.menuAtmosphere {
  top:
    -320px !important;

  right:
    -180px !important;

  width:
    720px !important;

  height:
    720px !important;

  background:
    radial-gradient(
      circle,
      rgba(195,168,217,.25),
      rgba(215,206,234,.09) 45%,
      transparent 70%
    )
    !important;
}


/* =========================================================
   MENU GRID ALIGNMENT
   ========================================================= */

.menuGrid {
  height:
    calc(100% - 55px)
    !important;

  padding:
    clamp(34px,4vh,50px)
    clamp(42px,4vw,72px)
    28px
    !important;

  grid-template-columns:
    minmax(260px,.80fr)
    minmax(310px,.92fr)
    minmax(270px,.78fr)
    !important;

  align-items:
    start !important;

  gap:
    clamp(38px,4vw,72px)
    !important;
}


/* =========================================================
   MENU INTRO
   ========================================================= */

.menuIntro {
  padding-top:
    10px !important;
}

.menuIntro h2 {
  margin-top:
    24px !important;

  font-size:
    clamp(38px,3.15vw,54px)
    !important;

  line-height:
    .96 !important;

  color:
    #211729 !important;
}

.menuIntro p {
  max-width:
    280px !important;

  margin-top:
    18px !important;

  color:
    rgba(43,31,52,.57)
    !important;

  font-size:
    11px !important;
}


/* =========================================================
   NAVIGATION COLUMN
   ========================================================= */

.menuNavigation {
  padding-left:
    clamp(20px,2vw,34px)
    !important;

  border-left:
    1px solid
    rgba(57,40,68,.09)
    !important;
}

.columnLabel {
  padding-bottom:
    17px !important;

  color:
    rgba(48,34,58,.42)
    !important;
}

.menuLinks a {
  min-height:
    50px !important;
}

.linkName {
  font-size:
    clamp(18px,1.35vw,23px)
    !important;

  color:
    #281b31
    !important;
}

.linkArrow {
  color:
    #754596 !important;

  opacity:
    .8 !important;
}


/* =========================================================
   EXPLORE COLUMN
   ========================================================= */

.menuExplore {
  padding-left:
    clamp(20px,2vw,34px)
    !important;

  border-left:
    1px solid
    rgba(57,40,68,.09)
    !important;
}

.menuExplore h3 {
  font-size:
    clamp(25px,2vw,34px)
    !important;

  color:
    #281b31
    !important;
}

.menuExplore > p {
  color:
    rgba(46,33,56,.54)
    !important;
}

.exploreLinks {
  margin-top:
    23px !important;
}


/* =========================================================
   MENU FOOTER
   ========================================================= */

.menuFooter {
  left:
    42px !important;

  right:
    42px !important;

  height:
    55px !important;

  color:
    rgba(49,35,59,.44)
    !important;
}


/* =========================================================
   BACKDROP
   ========================================================= */

/*
 * Backdrop is intentionally extremely subtle.
 * Hero/menu should feel like one composition rather than
 * a conventional modal dialog.
 */

.menuBackdrop {
  background:
    rgba(32,24,42,.12)
    !important;

  backdrop-filter:
    blur(5px)
    !important;

  -webkit-backdrop-filter:
    blur(5px)
    !important;
}


/* =========================================================
   SMALL LAPTOP
   ========================================================= */

@media (
  min-width: 981px
) and (
  max-width: 1180px
) {

  .header {
    padding-inline:
      24px !important;
  }

  .brandPill {
    min-width:
      124px !important;
  }

  .primaryNav {
    gap:
      3px !important;
  }

  .navPill {
    padding-inline:
      11px !important;
  }

  .megaMenu {
    left:
      22px !important;

    right:
      22px !important;

    height:
      calc(87svh - 67px)
      !important;
  }

  .menuGrid {
    grid-template-columns:
      minmax(220px,.70fr)
      minmax(285px,1fr)
      minmax(235px,.76fr)
      !important;

    padding-inline:
      34px !important;

    gap:
      30px !important;
  }

}


/* =========================================================
   TABLET
   ========================================================= */

@media (
  min-width: 761px
) and (
  max-width: 980px
) {

  .header {
    top:
      11px !important;

    padding-inline:
      18px !important;
  }

  .navShell {
    display:
      flex !important;

    justify-content:
      space-between !important;
  }

  .primaryNav,
  .projectPill {
    display:
      none !important;
  }

  .brandPill {
    height:
      45px !important;

    min-width:
      125px !important;
  }

  .soundPill {
    height:
      45px !important;
  }

  .menuPill {
    height:
      45px !important;

    min-width:
      78px !important;
  }

  /*
   * Tablet hero is 90svh.
   * Menu fills that same visual card.
   */

  .megaMenu {
    top:
      68px !important;

    left:
      18px !important;

    right:
      18px !important;

    width:
      auto !important;

    height:
      calc(90svh - 53px)
      !important;

    min-height:
      570px !important;

    max-height:
      none !important;

    border-radius:
      23px !important;
  }

  .menuGrid {
    height:
      calc(100% - 52px)
      !important;

    padding:
      32px
      28px
      24px
      !important;

    grid-template-columns:
      minmax(200px,.72fr)
      minmax(260px,1fr)
      !important;

    gap:
      30px !important;

    overflow-y:
      auto !important;
  }

  /*
   * Explore flows under the main navigation rather than
   * being squeezed into a third narrow column.
   */

  .menuExplore {
    grid-column:
      2 !important;

    padding-left:
      0 !important;

    margin-top:
      10px !important;

    border-left:
      0 !important;
  }

  .menuIntro {
    grid-row:
      1 / span 2 !important;
  }

  .menuFooter {
    left:
      28px !important;

    right:
      28px !important;

    height:
      52px !important;
  }

}


/* =========================================================
   MOBILE
   ========================================================= */

@media (
