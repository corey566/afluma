  }

}



/* ==========================================================
   ASK AFLUMA
   ========================================================== */

.askPill {
  appearance: none;

  height: 42px;

  display: inline-flex;
  align-items: center;

  gap: 8px;

  padding:
    0 15px;

  border:
    1px solid transparent;

  border-radius:
    999px;

  font: inherit;

  font-size: 11px;
  font-weight: 600;

  letter-spacing:
    -0.01em;

  cursor: pointer;

  transition:
    color 180ms ease,
    background 180ms ease,
    border-color 180ms ease,
    transform 180ms ease;
}


.header[data-surface='hero']
.askPill {
  color:
    rgba(255, 255, 255, 0.92);

  background:
    rgba(255, 255, 255, 0.09);

  border-color:
    rgba(255, 255, 255, 0.12);

  backdrop-filter:
    blur(14px);
}


.header[data-surface='page']
.askPill {
  color:
    rgba(10, 11, 10, 0.92);

  background:
    rgba(10, 11, 10, 0.055);

  border-color:
    rgba(10, 11, 10, 0.07);
}


.askPill:hover {
  transform:
    translateY(-1px);
}


.header[data-surface='hero']
.askPill:hover {
  color: #fff;

  background:
    rgba(255, 255, 255, 0.15);
}


.header[data-surface='page']
.askPill:hover {
  background:
    rgba(10, 11, 10, 0.095);
}


.askSpark {
  display: inline-flex;

  color:
    #cef8d4;

  font-size: 13px;

  line-height: 1;
}


.header[data-surface='page']
.askSpark {
  color:
    #245c30;
}


@media (max-width: 1240px) {

  .askPill {
    display: none;
  }

}


@media (
  prefers-reduced-motion:
  reduce
) {

  .askPill {
    transition: none;
  }

}

/* ==========================================================
   ASK AFLUMA E2 â€” HERO / NAV VISUAL ALIGNMENT
   ========================================================== */

.header[data-surface='hero']
.askPill {
  color:
    rgba(255, 255, 255, 0.96);

  background:
    rgba(255, 255, 255, 0.14);

  border-color:
    rgba(255, 255, 255, 0.2);

  box-shadow:
    inset 0 1px 0
    rgba(255, 255, 255, 0.18);

  backdrop-filter:
    blur(18px);
}


.header[data-surface='hero']
.askPill:hover {
  background:
    rgba(255, 255, 255, 0.21);

  border-color:
    rgba(255, 255, 255, 0.28);
}


.header[data-surface='hero']
.askSpark {
  color:
    #ddd5ff;
}


.header[data-surface='page']
.askPill {
  color:
    #3c3854;

  background:
    rgba(114, 88, 239, 0.065);

  border-color:
    rgba(114, 88, 239, 0.09);
}


.header[data-surface='page']
.askPill:hover {
  background:
    rgba(114, 88, 239, 0.105);
}


.header[data-surface='page']
.askSpark {
  color:
    #7458e8;
}

/* AFLUMA NAV V1 MOBILE FIX */
@media (max-width: 760px) {
  /*
   * Mobile menu scrolls as one surface rather than behaving
   * like the three-column desktop menu stacked vertically.
   */
  .megaMenu {
    overflow-x: hidden;
    overflow-y: auto;
    overscroll-behavior: contain;
    -webkit-overflow-scrolling: touch;
  }

  /*
   * Let the content determine its height.
   * The full mega menu becomes the scrolling container.
   */
  .menuGrid {
    display: block;
    height: auto;
    min-height: 0;
    overflow: visible;
  }

  /*
   * Make the introduction concise on small screens.
   */
  .menuIntro {
    margin-bottom: 30px;
  }

  .menuIntro h2 {
    max-width: 9ch;
    font-size: clamp(2.7rem, 12vw, 4rem);
    line-height: 0.94;
  }

  .menuIntro h2 br {
    display: none;
  }

  .menuIntro p {
    max-width: 34rem;
  }

  /*
   * Give the primary navigation breathing room without
   * making the overall menu unnecessarily long.
   */
  .menuNavigation {
    margin-top: 0;
  }

  /*
   * Desktop gets the large editorial Explore introduction.
   * Mobile only needs the label and direct links.
   */
  .menuExplore {
    margin-top: 34px;
  }

  .menuExplore h3,
  .menuExplore > p {
    display: none;
  }

  .exploreLinks {
    margin-top: 12px;
  }

  /*
   * The footer participates in normal document flow on
   * mobile instead of covering the final Explore links.
   */
  .menuFooter {
    position: static;
    inset: auto;
    margin-top: 28px;

    /*
     * Protect the last menu content from the floating
     * Ask Afluma control and iPhone safe-area.
     */
    padding-bottom:
      calc(112px + env(safe-area-inset-bottom));
  }
}

@media (max-width: 420px) {
  .menuIntro {
    margin-bottom: 26px;
  }

  .menuExplore {
    margin-top: 28px;
  }

  .menuFooter {
    padding-bottom:
      calc(104px + env(safe-area-inset-bottom));
  }
}
/* END AFLUMA NAV V1 MOBILE FIX */
