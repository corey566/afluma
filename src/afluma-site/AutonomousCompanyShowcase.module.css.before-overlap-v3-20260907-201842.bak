.section {
  /*
   * AFLUMA BRAND V2
   *
   * White / ivory
   * Near-black plum
   * Signature violet
   * Electric lavender
   *
   * This section intentionally overlaps the hero.
   */
  --afluma-ink: #120d1b;
  --afluma-ink-soft: #21162f;

  --afluma-violet: #7657ff;
  --afluma-violet-bright: #8f73ff;
  --afluma-violet-deep: #5131d8;

  --afluma-lavender: #c7baff;
  --afluma-lilac: #eeeaff;
  --afluma-paper: #fbfaff;
  --afluma-white: #ffffff;

  position: relative;
  z-index: 20;

  /*
   * Pull Section 2 over the bottom of the hero.
   */
  margin-top: clamp(-112px, -7vw, -66px);

  /*
   * Escape any parent content width.
   */
  width: 100vw;
  max-width: none;

  margin-left: calc(50% - 50vw);
  margin-right: calc(50% - 50vw);

  padding: 0;

  background: transparent;

  isolation: isolate;
}

/*
 * A subtle Afluma glow where the new section enters over the hero.
 */
.section::before {
  content: "";
  position: absolute;

  top: -120px;
  left: 0;
  right: 0;

  height: 230px;

  pointer-events: none;
  z-index: -1;

  background:
    radial-gradient(
      ellipse at 50% 80%,
      rgba(118, 87, 255, 0.30),
      rgba(118, 87, 255, 0.08) 40%,
      transparent 72%
    );

  filter: blur(26px);
}

.shell {
  position: relative;

  width: 100%;
  max-width: none;

  margin: 0;

  min-height: 100svh;

  padding:
    clamp(72px, 8vw, 136px)
    clamp(22px, 6vw, 112px)
    clamp(80px, 8vw, 130px);

  overflow: hidden;

  /*
   * Only the entering/top corners are rounded.
   * The section itself becomes a full-width page surface.
   */
  border-radius:
    clamp(34px, 4vw, 64px)
    clamp(34px, 4vw, 64px)
    0
    0;

  color: var(--afluma-white);

  background:
    radial-gradient(
      circle at 83% 13%,
      rgba(143, 115, 255, 0.44),
      transparent 28%
    ),
    radial-gradient(
      circle at 16% 76%,
      rgba(96, 61, 224, 0.24),
      transparent 34%
    ),
    linear-gradient(
      135deg,
      #120d1b 0%,
      #1c112d 44%,
      #24143c 72%,
      #130d1d 100%
    );

  box-shadow:
    0 -22px 70px rgba(73, 46, 135, 0.18),
    0 -1px 0 rgba(255, 255, 255, 0.16);
}

/*
 * Very restrained brand texture.
 */
.shell::before {
  content: "";
  position: absolute;
  inset: 0;

  pointer-events: none;

  opacity: 0.27;

  background-image:
    linear-gradient(
      rgba(255, 255, 255, 0.022) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.018) 1px,
      transparent 1px
    );

  background-size: 54px 54px;

  mask-image:
    linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.65),
      transparent 74%
    );
}

.header,
.composition {
  position: relative;
  z-index: 2;
}

.header {
  display: grid;

  grid-template-columns:
    minmax(0, 1.22fr)
    minmax(340px, 0.78fr);

  gap: clamp(54px, 8vw, 150px);

  align-items: end;

  width: min(1580px, 100%);
  margin: 0 auto clamp(40px, 5.6vw, 88px);
}

.eyebrow {
  display: inline-flex;
  align-items: center;

  gap: 10px;

  color: var(--afluma-lavender);

  font-size: 0.70rem;
  font-weight: 700;

  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.dot {
  width: 7px;
  height: 7px;

  flex: 0 0 auto;

  border-radius: 999px;

  background: var(--afluma-violet-bright);

  box-shadow:
    0 0 0 4px rgba(143, 115, 255, 0.10),
    0 0 24px rgba(143, 115, 255, 0.82);
}

.headingBlock h2 {
  max-width: 920px;

  margin: 20px 0 0;

  color: var(--afluma-white);

  font-size: clamp(3.65rem, 5.6vw, 7.2rem);
  font-weight: 500;

  line-height: 0.90;
  letter-spacing: -0.068em;
}

.headingBlock h2 span {
  color: var(--afluma-violet-bright);

  text-shadow:
    0 0 36px rgba(118, 87, 255, 0.20);
}

.intro {
  padding-bottom: 8px;
}

.intro p {
  max-width: 610px;

  margin: 0;

  color: rgba(255, 255, 255, 0.70);

  font-size: clamp(1rem, 1.16vw, 1.18rem);
  line-height: 1.72;
}

.statusLine {
  display: flex;
  flex-wrap: wrap;

  gap: 8px;

  margin-top: 26px;
}

.statusLine span {
  padding: 9px 13px;

  border:
    1px solid
    rgba(199, 186, 255, 0.22);

  border-radius: 999px;

  background:
    rgba(118, 87, 255, 0.09);

  color:
    rgba(237, 232, 255, 0.82);

  font-size: 0.65rem;

  letter-spacing: 0.09em;
  text-transform: uppercase;
}

/* =====================================================
   EDITORIAL COMPOSITION
   ===================================================== */

.composition {
  display: grid;

  grid-template-columns:
    minmax(480px, 0.91fr)
    minmax(560px, 1.09fr);

  gap: clamp(14px, 1.35vw, 24px);

  width: min(1580px, 100%);

  margin: 0 auto;
}

/* =====================================================
   LARGE VISUAL
   ===================================================== */

.visual {
  position: relative;

  min-height: clamp(650px, 67vw, 880px);

  overflow: hidden;

  border:
    1px solid
    rgba(207, 194, 255, 0.19);

  border-radius:
    clamp(26px, 2.5vw, 38px);

  background:
    #211431;

  color: white;
  text-decoration: none;

  isolation: isolate;

  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.10),
    0 28px 80px rgba(3, 0, 10, 0.18);
}

.visual img {
  position: absolute;

  inset: 0;

  z-index: -4;

  width: 100%;
  height: 100%;

  object-fit: cover;
  object-position: center;

  /*
   * Remove the orange dominance from the source visual.
   * We tint it through the Afluma violet system below.
   */
  filter:
    grayscale(0.34)
    saturate(0.78)
    contrast(1.08);

  transform: scale(1.015);

  transition:
    transform 900ms
    cubic-bezier(.2, .8, .2, 1);
}

/*
 * Violet brand tint.
 */
.visual::before {
  content: "";

  position: absolute;
  inset: 0;

  z-index: -3;

  pointer-events: none;

  background:
    linear-gradient(
      145deg,
      rgba(81, 49, 216, 0.55) 0%,
      rgba(118, 87, 255, 0.24) 33%,
      rgba(36, 20, 60, 0.08) 59%,
      rgba(118, 87, 255, 0.34) 100%
    );

  mix-blend-mode: color;
}

/*
 * Afluma violet atmosphere.
 */
.visual::after {
  content: "";

  position: absolute;
  inset: 0;

  z-index: -2;

  pointer-events: none;

  background:
    radial-gradient(
      circle at 78% 22%,
      rgba(158, 132, 255, 0.34),
      transparent 34%
    ),
    linear-gradient(
      180deg,
      rgba(16, 10, 27, 0.03) 20%,
      rgba(16, 10, 27, 0.17) 52%,
      rgba(12, 7, 20, 0.94) 100%
    );
}

.visual:hover img {
  transform: scale(1.052);
}

.visualShade {
  display: none;
}

.visualTop,
.visualBottom {
  position: absolute;

  left: clamp(20px, 2.5vw, 40px);
  right: clamp(20px, 2.5vw, 40px);

  z-index: 3;
}

.visualTop {
  top: clamp(20px, 2.5vw, 36px);

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 14px;

  color:
    rgba(255, 255, 255, 0.80);

  font-size: 0.66rem;
  font-weight: 700;

  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.status {
  padding: 8px 12px;

  border:
    1px solid
    rgba(224, 215, 255, 0.25);

  border-radius: 999px;

  background:
    rgba(20, 12, 33, 0.50);

  backdrop-filter: blur(14px);
}

.visualBottom {
  bottom: clamp(24px, 3vw, 42px);
}

.visualBottom p {
  max-width: 530px;

  margin: 0 0 25px;

  color:
    rgba(255, 255, 255, 0.85);

  font-size:
    clamp(1.03rem, 1.25vw, 1.28rem);

  line-height: 1.55;
}

.visualLink {
  display: inline-flex;

  align-items: center;

  gap: 9px;

  color: white;

  font-size: 0.81rem;
  font-weight: 700;
}

/* =====================================================
   RIGHT EDITORIAL SIDE
   ===================================================== */

.right {
  display: grid;

  grid-template-rows:
    auto
    1fr
    auto;

  gap:
    clamp(14px, 1.35vw, 24px);
}

.statement {
  min-height: 250px;

  padding:
    clamp(28px, 3vw, 46px);

  border:
    1px solid
    rgba(203, 188, 255, 0.18);

  border-radius:
    clamp(24px, 2.2vw, 34px);

  background:
    radial-gradient(
      circle at 92% 0%,
      rgba(142, 106, 255, 0.22),
      transparent 37%
    ),
    linear-gradient(
      140deg,
      rgba(118, 87, 255, 0.14),
      rgba(255, 255, 255, 0.045)
    );

  box-shadow:
    inset 0 1px 0
    rgba(255, 255, 255, 0.07);
}

.microLabel {
  color:
    var(--afluma-violet-bright);

  font-size: 0.67rem;
  font-weight: 700;

  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.statement p {
  max-width: 760px;

  margin:
    clamp(42px, 5vw, 76px)
    0
    0;

  color:
    rgba(255, 255, 255, 0.70);

  font-size:
    clamp(1.02rem, 1.22vw, 1.22rem);

  line-height: 1.68;
}

.statement strong {
  color: white;
  font-weight: 600;
}

/* =====================================================
   SYSTEM BLOCKS
   ===================================================== */

.cardGrid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap:
    clamp(12px, 1.1vw, 18px);
}

.systemCard,
.governanceCard {
  min-height: 230px;

  padding:
    clamp(20px, 2vw, 29px);

  border:
    1px solid
    rgba(207, 194, 255, 0.16);

  border-radius:
    clamp(20px, 1.9vw, 28px);

  overflow: hidden;
}

.systemCard {
  display: flex;

  flex-direction: column;
  justify-content: space-between;

  color: white;
  text-decoration: none;

  transition:
    transform 260ms ease,
    border-color 260ms ease,
    background-color 260ms ease;
}

.systemCard:hover {
  transform: translateY(-4px);

  border-color:
    rgba(159, 132, 255, 0.58);
}

.cardTop {
  display: flex;

  justify-content: space-between;

  gap: 12px;

  color:
    rgba(233, 226, 255, 0.50);

  font-size: 0.62rem;

  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.systemCard strong {
  display: block;

  margin-bottom: 10px;

  font-size:
    clamp(1.22rem, 1.5vw, 1.52rem);

  font-weight: 600;
}

.systemCard p {
  max-width: 340px;

  margin: 0;

  color:
    rgba(255, 255, 255, 0.63);

  font-size: 0.83rem;
  line-height: 1.52;
}

.agenticCard {
  background:
    radial-gradient(
      circle at 100% 100%,
      rgba(132, 91, 255, 0.40),
      transparent 55%
    ),
    rgba(255, 255, 255, 0.045);
}

.serenCard {
  background:
    radial-gradient(
      circle at 2% 100%,
      rgba(94, 61, 220, 0.34),
      transparent 58%
    ),
    rgba(255, 255, 255, 0.04);
}

.commerceCard {
  background:
    radial-gradient(
      circle at 100% 4%,
      rgba(174, 143, 255, 0.25),
      transparent 54%
    ),
    rgba(255, 255, 255, 0.045);
}

.governanceCard {
  display: flex;

  flex-direction: column;
  justify-content: space-between;

  color: var(--afluma-ink);

  background:
    radial-gradient(
      circle at 95% 8%,
      rgba(118, 87, 255, 0.22),
      transparent 42%
    ),
    linear-gradient(
      145deg,
      #ffffff,
      #eee9ff
    );
}

.governanceCard > div {
  display: flex;

  align-items: center;

  gap: 10px;

  font-size: 0.70rem;
  font-weight: 700;

  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.governanceIcon {
  display: grid;

  width: 34px;
  height: 34px;

  place-items: center;

  border-radius: 999px;

  color: white;

  background:
    linear-gradient(
      145deg,
      var(--afluma-violet-bright),
      var(--afluma-violet-deep)
    );

  box-shadow:
    0 8px 24px
    rgba(118, 87, 255, 0.30);
}

.governanceCard p {
  margin: 34px 0 0;

  font-size: 0.95rem;
  line-height: 1.55;
}

/* =====================================================
   SECTION FOOTER
   ===================================================== */

.footer {
  display: flex;

  justify-content: space-between;
  align-items: center;

  gap: 22px;

  min-height: 74px;

  padding:
    0 8px;

  color:
    rgba(230, 223, 255, 0.48);

  font-size: 0.73rem;
}

.footer a {
  color:
    var(--afluma-lavender);

  font-weight: 700;
  text-decoration: none;
}

/* =====================================================
   TABLET
   ===================================================== */

@media (max-width: 1080px) {
  .header,
  .composition {
    grid-template-columns: 1fr;
  }

  .header {
    gap: 30px;
  }

  .intro {
    max-width: 780px;
  }

  .visual {
    min-height: 660px;
  }
}

/* =====================================================
   MOBILE
   ===================================================== */

@media (max-width: 700px) {
  .section {
    /*
     * Still overlap on mobile, but less aggressively.
     */
    margin-top: -34px;
  }

  .shell {
    min-height: auto;

    padding:
      48px
      12px
      50px;

    border-radius:
      26px
      26px
      0
      0;
  }

  .header {
    width: 100%;

    gap: 22px;

    margin-bottom: 24px;
  }

  .headingBlock {
    padding: 0 6px;
  }

  .headingBlock h2 {
    margin-top: 14px;

    font-size:
      clamp(2.85rem, 12.1vw, 4.15rem);

    line-height: 0.91;
  }

  .intro {
    padding: 0 6px;
  }

  .intro p {
    font-size: 0.91rem;
    line-height: 1.58;
  }

  .statusLine {
    margin-top: 17px;
  }

  .statusLine span {
    padding: 7px 9px;
    font-size: 0.56rem;
  }

  .composition {
    width: 100%;

    gap: 10px;
  }

  .visual {
    min-height: 500px;

    border-radius: 22px;
  }

  .visualTop {
    flex-direction: column;
    align-items: flex-start;
  }

  .visualBottom p {
    max-width: 88%;

    font-size: 0.94rem;
  }

  .right {
    gap: 10px;
  }

  .statement {
    min-height: auto;

    padding: 23px 18px;

    border-radius: 21px;
  }

  .statement p {
    margin-top: 32px;

    font-size: 0.92rem;
    line-height: 1.55;
  }

  /*
   * Keep the mobile layout editorial,
   * not a huge vertical stack of identical feature cards.
   */
  .cardGrid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));

    gap: 8px;
  }

  .systemCard,
  .governanceCard {
    min-height: 168px;

    padding: 15px;

    border-radius: 18px;
  }

  .systemCard strong {
    font-size: 1.03rem;
  }

  .systemCard p {
    font-size: 0.69rem;
    line-height: 1.42;
  }

  .cardTop {
    font-size: 0.50rem;
  }

  /*
   * Give the two important lower blocks more width.
   */
  .commerceCard,
  .governanceCard {
    grid-column: 1 / -1;

    min-height: 145px;
  }

  .governanceCard p {
    margin-top: 26px;

    font-size: 0.82rem;
  }

  .footer {
    flex-direction: column;
    align-items: flex-start;

    min-height: auto;

    padding: 12px 5px 4px;
  }
}

@media (max-width: 380px) {
  .headingBlock h2 {
    font-size:
      clamp(2.5rem, 11.8vw, 3.2rem);
  }

  .systemCard {
    min-height: 158px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .visual img,
  .systemCard {
    transition: none;
  }
}