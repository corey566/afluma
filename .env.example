# Application
SERVER_URL=http://localhost:3000
NEXT_PUBLIC_SERVER_URL=http://localhost:3000
PAYLOAD_SECRET=replace-with-at-least-32-random-characters
PREVIEW_SECRET=replace-with-a-separate-random-secret
REVALIDATE_SECRET=replace-with-a-third-random-secret

# PostgreSQL
DATABASE_URL=postgresql://afluma:change-me@localhost:5432/afluma

# Cloudflare R2 through the S3-compatible API
R2_BUCKET=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
R2_PUBLIC_URL=https://media.afluma.com

# Form protection / delivery (configure before launch)
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
ENQUIRY_NOTIFICATION_EMAIL=

# Optional integrations editable in CMS after deployment
NEXT_PUBLIC_ANALYTICS_ENABLED=false


# Afluma Core / AgenticOS development
# Keep Ollama disabled initially; deterministic zero-cost triage remains active.
AFLUMA_OLLAMA_ENABLED=false
OLLAMA_BASE_URL=http://127.0.0.1:11434
AFLUMA_REASONING_MODEL=qwen3:4b

# Security: local model endpoints only by default.
# Set true only after explicitly reviewing a remote endpoint.
AFLUMA_ALLOW_REMOTE_MODEL_PROVIDER=false

# Public canonical URL and optional product launch sites (HTTPS only)
SEO_SITE_URL=https://afluma.com
SERENOPS_SITE_URL=
COMMERCE_SITE_URL=
COMMANDER_SITE_URL=
