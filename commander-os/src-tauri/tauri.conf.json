{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Afluma Commander OS",
  "version": "0.1.0",
  "identifier": "com.afluma.commander",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{"title":"Afluma Commander OS","width":1440,"height":920,"minWidth":1040,"minHeight":700,"resizable":true,"fullscreen":false,"center":true}],
    "security": {"csp": null}
  },
  "plugins": {"sql": {"preload": ["sqlite:commander.db"]}},
  "bundle": {"active": true,"targets": "all"}
}
